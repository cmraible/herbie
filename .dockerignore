# Build context is an allowlist. Re-exclude each directory after opening it
# so Docker does not implicitly include sibling files, tests, or local secrets.
*
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!packages/
packages/*
!packages/contracts/
packages/contracts/*
!packages/contracts/package.json
!packages/contracts/tsconfig.json
!packages/contracts/src/
packages/contracts/src/*
!packages/contracts/src/*.ts
!packages/loop/
packages/loop/*
!packages/loop/package.json
!packages/loop/tsconfig.json
!packages/loop/src/
packages/loop/src/*
!packages/loop/src/*.ts
!packages/service/
packages/service/*
!packages/service/package.json
!packages/service/tsconfig.json
!packages/service/src/
packages/service/src/*
!packages/service/src/*.ts
!packages/service/src/schema.sql
!packages/web/
packages/web/*
!packages/web/package.json
!packages/web/tsconfig.json
!packages/web/vite.config.ts
!packages/web/index.html
!packages/web/src/
packages/web/src/*
!packages/web/src/*.ts
!packages/web/src/*.tsx
!packages/web/src/*.css
!packages/web/public/
packages/web/public/*
!packages/web/public/_headers
