# Copy to .env locally; pnpm service/worker load it via Node's --env-file-if-exists.
# Demo: deterministic simulated executor, local PostgreSQL, no external calls.
HERBIE_MODE=demo
HERBIE_HOST=127.0.0.1
HERBIE_PORT=8787
HERBIE_PUBLIC_URL=http://127.0.0.1:8787
DATABASE_URL=postgresql://herbie:herbie-local-only@127.0.0.1:55432/herbie

# Live mode requires a separately approved GitHub App and existing Daytona setup.
# HERBIE_MODE=live
# HERBIE_EXECUTION_ENABLED=false # Live default; explicitly enable only after approval.
# HERBIE_PUBLIC_URL=https://herbie.example.com
# HERBIE_CREDENTIAL_KEY=<32 random bytes, base64; keep stable and secret>
# GITHUB_APP_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY_FILE=/private/path/app.pem
# GITHUB_PRIVATE_KEY=<inline PEM instead of GITHUB_PRIVATE_KEY_FILE>
# GITHUB_WEBHOOK_SECRET=
# HERBIE_DATABASE_CA_FILE=/private/path/supabase-ca.crt
# HERBIE_DATABASE_CA=<inline public CA PEM instead of HERBIE_DATABASE_CA_FILE>
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# HERBIE_DAYTONA_OPENAI_SECRET=<existing Daytona organization secret name>
# HERBIE_DAYTONA_SNAPSHOT=<optional existing approved Ubuntu snapshot>
