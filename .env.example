# Copy to .env and fill the credentials for the default local Compose stack.
# See docs/setup.md for GitHub App, Daytona, and tunnel setup.
# The current checkout is built locally; nothing needs to be pushed or merged.
HERBIE_PUBLIC_URL=https://herbie-dev.example.com
# Start with login/repository discovery; set true to run real projects.
HERBIE_EXECUTION_ENABLED=false
# Optional host port for Compose; the container always listens on 8787.
HERBIE_LOCAL_PORT=8787
# Required tunnel token. Route the hostname to http://herbie:8787.
CLOUDFLARE_TUNNEL_TOKEN=

# The local Compose database uses a fixed development-only password automatically.
# Generate the credential encryption key with: openssl rand -base64 32
# Keep this key stable: it encrypts saved GitHub credentials in the database.
HERBIE_CREDENTIAL_KEY=

# Register a separate test GitHub App, e.g. herbie-chris-dev (unique name).
# Find your numeric user ID with: gh api user --jq .id
HERBIE_ALLOWED_GITHUB_USER_ID=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Paste the ENTIRE downloaded PEM between single quotes, with real newlines.
# Example (remove the comment prefixes when pasting):
# GITHUB_PRIVATE_KEY='-----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----'
GITHUB_PRIVATE_KEY=
# Generate with: openssl rand -hex 32; use the same value in the App settings.
GITHUB_WEBHOOK_SECRET=

# Dedicated test OpenAI project/key for service-side project naming.
OPENAI_API_KEY=
# Dedicated test Daytona organization/API key with sandbox lifecycle access.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# NAME of a Daytona organization secret holding a separate test OpenAI key.
# Create that secret in Daytona; do not put the sandbox OpenAI key here.
HERBIE_DAYTONA_OPENAI_SECRET=herbie-dev-openai

# Environment provider (default: daytona). E2B uses a prebuilt runtime template.
HERBIE_ENVIRONMENT_PROVIDER=daytona
# E2B_API_KEY=
# HERBIE_E2B_TEMPLATE=herbie-runtime
# HERBIE_E2B_OPENAI_SECRET=openai-api-key
