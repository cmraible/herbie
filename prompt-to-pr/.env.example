PUBLIC_URL=http://localhost:8787
PORT=8787
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://bot:replace-with-a-random-password@db:5432/prompt_to_pr
DATABASE_SCHEMA=prompt_to_pr
# Optional private certificate authority for verified remote database TLS.
DATABASE_CA=
AUTH_SECRET=replace-with-at-least-32-random-characters
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM key with literal \n separators, or a multiline quoted value in the environment file.
GITHUB_PRIVATE_KEY=
# Comma-separated numeric GitHub user IDs permitted in the private beta.
ALLOWED_GITHUB_IDS=
E2B_TEMPLATE=
E2B_API_KEY=
# Name of a E2B-managed OpenAI secret, not the raw OpenAI API key.
E2B_OPENAI_SECRET=
AGENT_MODEL=gpt-6-luna
