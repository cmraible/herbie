{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "herbie-service",
  "account_id": "3e763a0e4e26f85d5bc3e5ea698faf06",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "HERBIE_PUBLIC_URL": "https://herbie-service.cmraible1.workers.dev",
    "HERBIE_DEPLOYMENT_ID": "local",
    "HERBIE_EXECUTION_ENABLED": "false"
  },
  "secrets": { "required": ["HERBIE_RUNTIME_SECRETS"] },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "containers": [{
    "class_name": "HerbieContainer",
    "image": "../../Dockerfile",
    "image_build_context": "../..",
    "image_vars": { "HERBIE_RUNTIME_REVISION": "1" },
    "scheduling_policy": "default",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{ "name": "HERBIE", "class_name": "HerbieContainer" }]
  },
  "exports": { "HerbieContainer": { "type": "durable-object", "storage": "sqlite" } },
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
