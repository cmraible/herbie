{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "herbie-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "HERBIE_PUBLIC_URL": "https://herbie.example.invalid",
    "HERBIE_DEPLOYMENT_ID": "local",
    "HERBIE_EXECUTION_ENABLED": "false"
  },
  "secrets": { "required": ["HERBIE_RUNTIME_SECRETS"] },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "containers": [{
    "class_name": "HerbieContainer",
    "image": "../../Dockerfile",
    "image_build_context": "../..",
    "image_vars": { "HERBIE_RUNTIME_REVISION": "1" },
    "scheduling_policy": "default",
    "instance_type": "basic",
    "max_instances": 1
  }, {
    "class_name": "ReleaseContainer",
    "scheduling_policy": "durable_object",
    "images": { "release": {
      "dockerfile": "../../Dockerfile",
      "build_context": "../..",
      "build_vars": { "HERBIE_RUNTIME_REVISION": "1" }
    } },
    "observability": { "logs": { "enabled": true } }
  }],
  "durable_objects": {
    "bindings": [
      { "name": "HERBIE", "class_name": "HerbieContainer" },
      { "name": "RELEASES", "class_name": "ReleaseContainer" },
      { "name": "ROUTER", "class_name": "ReleaseRouter" }
    ]
  },
  "exports": {
    "HerbieContainer": { "type": "durable-object", "storage": "sqlite" },
    "ReleaseContainer": { "type": "durable-object", "storage": "sqlite" },
    "ReleaseRouter": { "type": "durable-object", "storage": "sqlite" }
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
