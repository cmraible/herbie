{
  "name": "@herbie/cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler types && tsc --noEmit",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx --test test/e2e.ts",
    "types": "wrangler types",
    "check:deploy": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
