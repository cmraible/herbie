{
  "name": "@herbie/loop",
  "version": "0.1.0",
  "private": true,
  "description": "A controller for managing AI loops.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./daytona-run": "./dist/daytona-run.js",
    "./publish-patch": "./dist/publish-patch.js",
