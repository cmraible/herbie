{
  "name": "@herbie/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && cp src/schema.sql dist/schema.sql",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker-main.ts",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@daytona/sdk": "0.220.0",
    "@herbie/contracts": "workspace:*",
    "@herbie/loop": "workspace:*",
    "@openai/codex": "0.159.2",
    "better-auth": "1.7.10",
    "pg": "^8.16.3",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.2"
  }
}
