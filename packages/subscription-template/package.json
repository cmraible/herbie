{
  "name": "@herbie/subscription-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings && node scripts/check-types.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:prepare": "tsx scripts/prepare.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "better-auth": "1.7.7",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "stripe": "23.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "otplib": "13.5.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6"
}
