{
  "name": "@herbie/agent-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --local",
    "db:migrate": "wrangler d1 migrations apply agent-factory --local",
    "types": "wrangler types --strict-vars=false --include-runtime=false",
    "test:worker": "pnpm build && tsx --test test/*.integration.ts"
  },
  "dependencies": {
    "@daytona/sdk": "0.220.0",
    "better-auth": "1.7.7",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "miniflare": "5.20260930.0-alpha",
    "wrangler": "4.145.0"
  }
}
