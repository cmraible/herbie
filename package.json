{
  "name": "herbie",
  "version": "0.1.0",
  "private": true,
  "description": "Herbie workspace: an AI loop controller and ChatGPT demo.",
  "type": "module",
  "scripts": {
    "start": "pnpm --filter @herbie/loop start",
    "demo": "pnpm --filter @herbie/demo start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @herbie/loop test:e2e"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.6",
  "license": "MIT"
}
