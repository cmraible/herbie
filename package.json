{
  "name": "herbie",
  "version": "0.1.0",
  "private": true,
  "description": "Herbie workspace: an AI loop controller and ChatGPT demo.",
  "type": "module",
  "scripts": {
    "start": "pnpm --filter @herbie/loop start",
    "demo": "pnpm --filter @herbie/demo start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @herbie/loop test:e2e",
    "test:daytona": "pnpm --filter @herbie/loop test:daytona",
    "service": "node --env-file-if-exists=.env --import tsx packages/service/src/index.ts",
    "worker": "node --env-file-if-exists=.env --import tsx packages/service/src/worker-main.ts",
    "cli": "pnpm --filter @herbie/cli start",
    "test:web": "pnpm --filter @herbie/web test:e2e"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.6",
  "license": "MIT"
}
