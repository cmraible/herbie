{
  "name": "herbie",
  "version": "0.1.0",
  "private": true,
  "description": "Herbie workspace: an AI loop controller and ChatGPT demo.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "node -e \"if (require('node:fs').existsSync('.git') && process.env.NODE_ENV !== 'production' && !process.env.CI) import('husky').then(m => console.log(m.default()))\"",
    "verify": "bash scripts/verify.sh",
    "start": "pnpm --filter @herbie/loop start",
    "demo": "pnpm --filter @herbie/demo start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @herbie/loop test:e2e",
    "test:daytona": "pnpm --filter @herbie/loop test:daytona",
    "service": "node --env-file-if-exists=.env --import tsx packages/service/src/index.ts",
    "worker": "node --env-file-if-exists=.env --import tsx packages/service/src/worker-main.ts",
    "cli": "pnpm --filter @herbie/cli start",
    "test:web": "pnpm --filter @herbie/web test:e2e"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --write"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6"
}
