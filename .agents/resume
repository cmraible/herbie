#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# Non-PATH profile changes are not carried into shared project snapshots.
# Restore test-only defaults after activation, without overriding supplied URLs.
profile_marker='# Herbie orb test databases'
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile"; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ "\$PWD" == "$repo_root" || "\$PWD" == "$repo_root/"* ]]; then
  export HERBIE_TEST_DATABASE_URL="\${HERBIE_TEST_DATABASE_URL:-postgresql://herbie_orb:herbie-orb-local-only@127.0.0.1:55432/herbie_orb_test}"
  export HERBIE_CI_DATABASE_URL="\${HERBIE_CI_DATABASE_URL:-postgresql://herbie_orb:herbie-orb-local-only@127.0.0.1:55432/herbie_orb_ci}"
fi
EOF
fi
sudo systemctl start docker postgresql@17-main
pg_isready -h 127.0.0.1 -p 55432
